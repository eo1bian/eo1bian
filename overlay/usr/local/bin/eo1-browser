#!/bin/sh
# Runs inside cage (Wayland kiosk compositor) as user eo1: Chromium full screen.
# It starts on a local status page (boot.html) that switches to the configured page as soon as it answers.
CONF=/etc/eo1/eo1.conf
GPU=$(sed -n 's/^gpu=//p' "$CONF" 2>/dev/null)

# rotation is done by cage (eo1-cage), not here
# nothing a wall frame needs: no extensions, no background networking, no crash uploads (a few tenths of a second)
EXTRA="--disable-extensions --disable-background-networking --disable-sync --disable-default-apps --disable-breakpad --no-pings"
# GPU: Chromium wants OpenGL ES 3.0; etnaviv on the GC2000 offers ES 2.0, so the GPU process always failed (twice,
# ~3 s at boot) and Chromium ended up rendering in software anyway (use-gl=disabled, measured 3 Nov 2026).
# Default: no GPU attempt at all. gpu=on in eo1.txt tries the GPU (for future driver/browser versions).
[ "$GPU" != "on" ] && EXTRA="$EXTRA --disable-gpu"

# a Chromium left over from a killed session holds the profile lock: the new one would hand over and exit 0
pkill -u eo1 -x chromium 2>/dev/null; pkill -u eo1 -f chrome_crashpad 2>/dev/null
rm -f "$HOME/.config/chromium/SingletonLock" "$HOME/.config/chromium/SingletonSocket" "$HOME/.config/chromium/SingletonCookie" 2>/dev/null
exec chromium \
	--kiosk --noerrdialogs --disable-infobars --no-first-run --password-store=basic \
	--ozone-platform=wayland --enable-features=UseOzonePlatform \
	--autoplay-policy=no-user-gesture-required --disable-features=Translate,TranslateUI,MediaRouter --lang=nb --accept-lang=nb-NO,nb,no,en \
	--check-for-update-interval=31536000 --disable-component-update \
	--remote-debugging-address=127.0.0.1 --remote-debugging-port=9222 --remote-allow-origins=* \
	--disk-cache-size=67108864 \
	$EXTRA \
	file:///usr/share/eo1/boot.html
