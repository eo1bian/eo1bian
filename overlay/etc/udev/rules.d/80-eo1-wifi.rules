# WL1271: the first 802.11 authentication after firmware boot got no answer in most boots (NetworkManager then
# rescanned, 8-12 s lost); power save is on by default in cfg80211 until NM sets wifi.powersave later: off from
# the moment the interface exists (2 Nov 2026 experiment)
ACTION=="add", SUBSYSTEM=="net", KERNEL=="wlan0", RUN+="/usr/sbin/iw dev wlan0 set power_save off"
