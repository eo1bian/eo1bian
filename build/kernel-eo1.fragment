# EO1 kernel: Debian's 6.1 armmp source and config, trimmed to the EO1 (i.MX6 Dual, Boundary EO board).
# Applied on top of config-6.1.0-54-armmp with scripts/kconfig/merge_config.sh (see build/kernel-build.sh).
# Goal: everything the boot needs built in (no module loading on the critical path), LZ4 instead of xz
# (xz decompression of a 20 MB kernel on a 1 GHz Cortex-A9 costs ~1.5 s), Wi-Fi firmware inside the kernel.

# --- compression: LZ4 (fast to decompress; the image is read from the eMMC at 66 MB/s)
CONFIG_KERNEL_XZ=n
CONFIG_KERNEL_LZ4=y

# --- only i.MX6 (the armmp config carries every ARMv7 platform; each one costs init time and size)
CONFIG_ARCH_MULTI_V6=n
CONFIG_ARCH_ACTIONS=n
CONFIG_ARCH_ALPINE=n
CONFIG_ARCH_ARTPEC=n
CONFIG_ARCH_AT91=n
CONFIG_ARCH_BCM=n
CONFIG_ARCH_BERLIN=n
CONFIG_ARCH_DIGICOLOR=n
CONFIG_ARCH_EXYNOS=n
CONFIG_ARCH_HIGHBANK=n
CONFIG_ARCH_HISI=n
CONFIG_ARCH_KEYSTONE=n
CONFIG_ARCH_MEDIATEK=n
CONFIG_ARCH_MESON=n
CONFIG_ARCH_MILBEAUT=n
CONFIG_ARCH_MMP=n
CONFIG_ARCH_MVEBU=n
CONFIG_ARCH_NPCM=n
CONFIG_ARCH_OMAP3=n
CONFIG_ARCH_OMAP4=n
CONFIG_SOC_OMAP5=n
CONFIG_SOC_AM33XX=n
CONFIG_SOC_AM43XX=n
CONFIG_SOC_DRA7XX=n
CONFIG_ARCH_QCOM=n
CONFIG_ARCH_RDA=n
CONFIG_ARCH_REALTEK=n
CONFIG_ARCH_RENESAS=n
CONFIG_ARCH_ROCKCHIP=n
CONFIG_ARCH_S5PV210=n
CONFIG_ARCH_SOCFPGA=n
CONFIG_ARCH_SUNXI=n
CONFIG_ARCH_SUNPLUS=n
CONFIG_ARCH_TEGRA=n
CONFIG_ARCH_U8500=n
CONFIG_ARCH_UNIPHIER=n
CONFIG_ARCH_VEXPRESS=n
CONFIG_ARCH_VIRT=n
CONFIG_ARCH_WM8850=n
CONFIG_ARCH_ZYNQ=n
CONFIG_ARCH_ASPEED=n
CONFIG_ARCH_STI=n
CONFIG_ARCH_STM32=n
CONFIG_ARCH_INTEL_SOCFPGA=n
CONFIG_ARCH_MXC=y
CONFIG_SOC_IMX6Q=y
CONFIG_SOC_IMX6SL=n
CONFIG_SOC_IMX6SLL=n
CONFIG_SOC_IMX6SX=n
CONFIG_SOC_IMX6UL=n
CONFIG_SOC_IMX7D=n
CONFIG_SOC_IMX7ULP=n
CONFIG_SOC_VF610=n
CONFIG_SOC_IMX5=n
CONFIG_SOC_LS1021A=n

# --- storage and filesystems on the boot path
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_ESDHC_IMX=y
CONFIG_MMC_CQHCI=y
CONFIG_EXT4_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_BLK_DEV_LOOP=y

# --- USB OTG host (the recovery stick, a keyboard)
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_USB_CHIPIDEA_UDC=n
CONFIG_USB_MXS_PHY=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=n
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# --- display: imx-drm pipeline, LVDS, backlight, GPU (the splash is drawn on fb0 from the initramfs)
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_IMX=y
CONFIG_DRM_IMX_LDB=y
CONFIG_DRM_IMX_PARALLEL_DISPLAY=y
CONFIG_DRM_IMX_HDMI=y
CONFIG_DRM_DW_HDMI=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_ETNAVIV=y
CONFIG_IMX_IPUV3_CORE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM=y
CONFIG_PWM_IMX27=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_LOGO=n

# --- Wi-Fi WL1271 on SDIO with the firmware inside the kernel (built in: no firmware files to wait for)
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_TI=y
CONFIG_WL12XX=y
CONFIG_WLCORE=y
CONFIG_WLCORE_SDIO=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_CFG80211_DEFAULT_PS=n
CONFIG_EXTRA_FIRMWARE="ti-connectivity/wl127x-fw-5-sr.bin ti-connectivity/wl127x-nvs.bin"
CONFIG_EXTRA_FIRMWARE_DIR="/lib/firmware"

# --- the rest of the board
CONFIG_I2C_IMX=y
CONFIG_I2C_CHARDEV=y
CONFIG_GPIO_MXC=y
CONFIG_SPI_IMX=n
CONFIG_MTD=n
CONFIG_SERIAL_IMX=y
CONFIG_SERIAL_IMX_CONSOLE=y
CONFIG_RTC_DRV_SNVS=y
CONFIG_IMX_THERMAL=y
CONFIG_ARM_IMX6Q_CPUFREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_IMX_SDMA=y
CONFIG_VIDEO_CODA=m
CONFIG_CRYPTO_DEV_FSL_CAAM=m

# --- not on the EO1 (and not worth probing at boot)
CONFIG_SATA_AHCI_PLATFORM=n
CONFIG_AHCI_IMX=n
CONFIG_PCI_IMX6=n
CONFIG_CAN=n
CONFIG_FEC=n
CONFIG_SOUND=n
CONFIG_SND=n
CONFIG_TOUCHSCREEN_EGALAX=n
CONFIG_TOUCHSCREEN_EDT_FT5X06=n
CONFIG_VIDEO_IMX_MEDIA=n
CONFIG_MEDIA_SUPPORT=m
CONFIG_INPUT_EVDEV=y

# --- less to initialise
CONFIG_SECURITY_APPARMOR=n
CONFIG_SECURITY_SELINUX=n
CONFIG_AUDIT=n
CONFIG_KEXEC=n
CONFIG_CRASH_DUMP=n
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_BTF=n
CONFIG_IKCONFIG=n
CONFIG_SUSPEND=n
CONFIG_HIBERNATION=n
CONFIG_PM_AUTOSLEEP=n
CONFIG_IPV6=y
CONFIG_NETFILTER=n
CONFIG_BRIDGE=n
CONFIG_WIRELESS_EXT=n

# --- learned from the first boot of this kernel (2 Nov 2026): built-in drivers waited for these modules and
# gave up after the 10 s deferred-probe timeout (GPU -110, USB host never powered, no root on the stick).
# Built in: everything the working armmp kernel loads on the EO1 that the boot path depends on.
CONFIG_REGULATOR=y
CONFIG_REGULATOR_ANATOP=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_GPIO=y
CONFIG_NVMEM_IMX_OCOTP=y
CONFIG_IMX_THERMAL=y
CONFIG_ARM_IMX6Q_CPUFREQ=y
CONFIG_USB_CHIPIDEA_IMX=y
CONFIG_USB_PHY=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_ULPI=y
CONFIG_USB_ULPI_BUS=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_MUX_MMIO=y
CONFIG_MULTIPLEXER=y
CONFIG_IMX_IPUV3_CORE=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_GEM_DMA_HELPER=y
CONFIG_DRM_SCHED=y
CONFIG_CEC_CORE=y
CONFIG_CRC16=y
CONFIG_LIBCRC32C=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_JBD2=y
CONFIG_FS_MBCACHE=y
CONFIG_SCSI_COMMON=y
CONFIG_INPUT_EVDEV=y
CONFIG_RFKILL=y
CONFIG_IMX2_WDT=y
CONFIG_IP_NF_IPTABLES=n
CONFIG_AUTOFS_FS=y
# a safety margin for anything still deferred
CONFIG_CMDLINE=""

# USB_GADGET=m capped the ChipIdea driver at =m (its Kconfig depends on EHCI && GADGET): no gadget mode on the EO1
CONFIG_USB_GADGET=n
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_IMX=y
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_NOP_USB_XCEIV=y
